rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Starter rule: all signed-in accounts in this Firebase project share this shop's records.
    // Only create accounts for trusted team members. For stronger owner/staff roles, add role-based rules.
    match /shops/{shopId}/records/{recordId} {
      allow read, write: if request.auth != null;
    }
  }
}
